--!strict
local RunService = game:GetService("RunService")
export type PartsManipulatorObject = {
	name: string,
	state: boolean,
	runConnection: RBXScriptConnection?,
	update: UpdateCallback,
	start: (self: PartsManipulatorObject) -> (),
	stop: (self: PartsManipulatorObject) -> (),
	toggle: (self: PartsManipulatorObject  , value: boolean) -> (),
	updatesCleaner : {[any] : () -> ()},
	params : Params,
}
type Params = {
	startCallback : Callback?,
	endCallback : Callback?,
}
type UpdateCallback = (self: PartsManipulatorObject) -> ()
type Callback = (PartsManipulatorObject) -> ()
local PartsManipulatorClass = {}
PartsManipulatorClass.__index = PartsManipulatorClass


function PartsManipulatorClass.new(name: string, updateCallback: UpdateCallback,params : Params): PartsManipulatorObject
	local self = setmetatable({}, PartsManipulatorClass) :: PartsManipulatorObject
	self.name = name
	self.state = false
	self.runConnection = nil
	self.updatesCleaner = {}
	self.update = updateCallback
	self.params = params
	return self
end

function PartsManipulatorClass.start(self : PartsManipulatorObject)
	if self.state then
		return
	end
	self.state = true
	if self.params.startCallback then
		self.params.startCallback(self)
	end
	self.runConnection = RunService.Heartbeat:Connect(function()
		self:update()
	end)
end

function PartsManipulatorClass.stop(self : PartsManipulatorObject)
	self.state = false
	if self.runConnection then
		self.runConnection:Disconnect()
		self.runConnection = nil
	end
	for key,cleaner in pairs(self.updatesCleaner) do
		cleaner()
		self.updatesCleaner[key] = nil
	end
	if self.params.endCallback then
		self.params.endCallback(self)
	end
end

function PartsManipulatorClass.toggle(self : PartsManipulatorObject, value: boolean)
	if value then
		self:start()
	else
		self:stop()
	end
end
return PartsManipulatorClass
